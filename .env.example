# 阿里云 百炼大模型 API (用于图文生成与提示词润色)
ALI_API_KEY=your_ali_api_key_here
ALI_MODEL=wanx2.1-t2i-turbo

# Supabase Storage Bucket
SUPABASE_BUCKET=gisfy-assets

# Supabase (Storage + PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Upstash Redis (SSO 会话管理)
# 使用 TLS 连接，字符串以 rediss:// 开头
REDIS_URL=rediss://default:your_password@your-instance.upstash.io:6379

# Generation queue worker controls
GENERATE_WORKER_CONCURRENCY=3
GENERATE_TASK_TIMEOUT_MS=120000
GENERATE_QUEUE_POLL_MS=500

# In-memory asset fallback controls
ASSET_STORE_MAX_PER_USER=1000
ASSET_STORE_TTL_MS=604800000

# Export controls
EXPORT_MAX_ITEMS=100
EXPORT_FETCH_CONCURRENCY=4

# JWT 签名密钥 (生成: openssl rand -hex 32)
JWT_SECRET=your_random_hex_string_here
